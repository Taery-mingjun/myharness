# MyHarness Environment Configuration

# --- LLM Providers ---
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# Google (Gemini)
GOOGLE_API_KEY=...
GOOGLE_DEFAULT_MODEL=gemini-2.0-flash

# Qwen (通义千问)
QWEN_API_KEY=...
QWEN_DEFAULT_MODEL=qwen-max

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# --- Default Provider ---
# One of: openai, anthropic, google, qwen, deepseek, local
MYH_DEFAULT_LLM_PROVIDER=openai

# --- Local Model (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1

# --- Memory ---
MYH_DATA_DIR=./data
MYH_EMBEDDING_DIMENSION=1536
MYH_VECTOR_INDEX_TYPE=IVFFlat

# --- API Server ---
MYH_API_HOST=127.0.0.1
MYH_API_PORT=8000
MYH_API_DEBUG=false

# --- API Authentication (fail-closed) ---
# If MYH_API_KEY is empty, ALL mutating endpoints reject requests.
MYH_API_KEY=
MYH_API_KEY_HEADER=X-API-Key

# --- CORS (explicit allowlist, no wildcard) ---
MYH_API_CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
MYH_API_CORS_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
MYH_API_CORS_HEADERS=["Authorization","Content-Type","X-API-Key"]

# --- Logging ---
MYH_LOG_LEVEL=INFO
MYH_LOG_FORMAT=json

# --- Runtime ---
MYH_COGNITIVE_LOOP_INTERVAL_MS=100
MYH_MAX_CONCURRENT_TASKS=10
MYH_DEFAULT_TASK_TIMEOUT=300
